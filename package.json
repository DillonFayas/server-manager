{
  "name": "server-manager",
  "version": "1.0.0",
  "description": "A web-based dashboard for managing and monitoring projects on your Raspberry Pi or Linux server.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node setup.js",
    "build": "npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DillonFayas/server-manager.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DillonFayas/server-manager/issues"
  },
  "homepage": "https://github.com/DillonFayas/server-manager#readme",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.7",
    "ws": "^8.14.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
